[Unit]
Description=Recover unfinished ARMHPC SSH policy changes
After=local-fs.target armhpc-firstboot.service armhpc-state.service
Before=ssh.service ssh.socket
ConditionPathExists=!/etc/armhpc/rescue-environment

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/armhpc/auth_config.py _recover
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
