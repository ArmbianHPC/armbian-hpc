[Unit]
Description=Activate explicitly configured ARMHPC encrypted swap
Requires=armhpc-runtime.service
After=armhpc-runtime.service
RequiresMountsFor=/data
Before=k3s.service k3s-agent.service
ConditionPathExists=!/etc/armhpc/rescue-environment

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/armhpc/swap_config.py _start
ExecStop=/usr/bin/python3 /usr/lib/armhpc/swap_config.py _stop
TimeoutStartSec=45
TimeoutStopSec=45
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
