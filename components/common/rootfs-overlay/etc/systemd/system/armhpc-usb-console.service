[Unit]
Description=ARMHPC board USB CDC ACM console
After=local-fs.target armhpc-firstboot.service
ConditionPathExists=/etc/armhpc/usb-console.json
StartLimitIntervalSec=90
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/lib/armhpc/usb_console.py start
ExecStop=/usr/bin/python3 /usr/lib/armhpc/usb_console.py stop
TimeoutStartSec=35
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
