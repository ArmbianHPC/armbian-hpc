[Unit]
Description=ARMHPC hardware-stock performance policy
After=local-fs.target systemd-udev-trigger.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/armhpc/performance.py
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
