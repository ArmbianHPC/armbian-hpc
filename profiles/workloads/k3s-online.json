{
  "schema_version": 1,
  "kind": "workload",
  "id": "k3s-online",
  "name": "首次 SSH 登录引导 / 在线 K3s",
  "architectures": [
    "arm64",
    "armhf"
  ],
  "component": "k3s",
  "packages": [
    "openssh-server",
    "sudo",
    "python3",
    "ca-certificates",
    "curl",
    "iptables",
    "iproute2",
    "util-linux",
    "kmod"
  ],
  "settings": {
    "deployment_mode": "ssh_wizard_online",
    "default_version": "v1.36.5+k3s1",
